ANTHROPIC_API_KEY=your_api_key_here
# Same default as definity-app's settings.llm_model ("anthropic:" prefix optional).
LLM_MODEL=claude-sonnet-4-6
RESULTS_DIR=data/results

# env_name passed to run_analysis (the Athena-backed context node ignores it;
# it only appears in the saved graph state).
ENV_NAME=athena

# Tenant pricing — mirrors tenant_settings defaults in definity-app.
# cost_per_run = VCORE_PRICE * task__vcore_time__allocated + MEMORY_PRICE * task__memory_time__allocated
VCORE_PRICE=0.05
MEMORY_PRICE=0.005

# Athena / AWS — for --athena batch mode
AWS_PROFILE=dev-admin
AWS_REGION=eu-north-1
ATHENA_DB=dev_app_analytics
ATHENA_TABLE=task_enrichments
S3_OUTPUT=s3://definity-athena-results/notebooks/

# --sample only picks (task_name, app_id) jobs with at least this many real
# enrichment rows in Athena, so historical_runs is real trend data, not synthetic.
MIN_HISTORICAL_RUNS=5

# Optional overrides for the agent's per-node ReAct iteration budgets
# (repo defaults live in backend agent/constants.py; 2 graph steps per
# tool-call iteration). The repo's safety default of 12 can crash with
# GraphRecursionError when the review inspects many recommendations.
SAFETY_REVIEW_RECURSION_LIMIT=24
#DISCOVERY_RECURSION_LIMIT=24
#TRIAGE_RECURSION_LIMIT=12
#PLAN_RECURSION_LIMIT=16
#EXPLAIN_RECURSION_LIMIT=12

# Postgres for evaluation/pg_nodes_runner.py / evaluation/compare_sql_stream.py (read replica)
PG_DATABASE_URL=postgresql://user:password@host:5432/app

# definity REST API — for tools/dump-rest-api.sh (Bearer token from an app
# login / the /token route; never commit the real value)
DEFINITY_API_BASE=https://definity-ai.infra.aks.prod.akamaicsi.net
DEFINITY_API_TOKEN=your_definity_jwt_here
