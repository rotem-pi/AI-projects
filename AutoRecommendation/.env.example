# Claude runs via Amazon Bedrock (langchain-aws bedrock_converse) — credentials
# come from AWS_PROFILE/AWS_REGION below, same chain as Athena. No Anthropic
# API key needed. This is the eu-north-1 cross-region inference profile ID
# (confirmed via `aws bedrock list-inference-profiles`) — the bare model ID
# "anthropic.claude-sonnet-4-6" exists but can't be invoked directly.
LLM_MODEL=eu.anthropic.claude-sonnet-4-6
RESULTS_DIR=data/results

# env_name passed to run_analysis (the Athena-backed context node ignores it;
# it only appears in the saved graph state).
ENV_NAME=athena

# Tenant pricing — mirrors tenant_settings defaults in definity-app.
# cost_per_run = VCORE_PRICE * task__vcore_time__allocated + MEMORY_PRICE * task__memory_time__allocated
VCORE_PRICE=0.05
MEMORY_PRICE=0.005

# Athena / AWS — for --athena batch mode
AWS_PROFILE=dev-admin
AWS_REGION=eu-north-1
ATHENA_DB=dev_app_analytics
ATHENA_TABLE=task_enrichments
S3_OUTPUT=s3://definity-athena-results/notebooks/

# --sample only picks (task_name, app_id) jobs with at least this many real
# enrichment rows in Athena, so historical_runs is real trend data, not synthetic.
MIN_HISTORICAL_RUNS=5

# Optional overrides for the agent's per-node ReAct iteration budgets
# (repo defaults live in backend agent/constants.py; 2 graph steps per
# tool-call iteration). The repo's safety default of 12 can crash with
# GraphRecursionError when the review inspects many recommendations.
SAFETY_REVIEW_RECURSION_LIMIT=24
#DISCOVERY_RECURSION_LIMIT=24
#TRIAGE_RECURSION_LIMIT=12
#PLAN_RECURSION_LIMIT=16
#EXPLAIN_RECURSION_LIMIT=12

# Postgres for evaluation/pg_nodes_runner.py / evaluation/compare_sql_stream.py (read replica)
PG_DATABASE_URL=postgresql://user:password@host:5432/app

# definity REST API — for tools/dump-rest-api.sh (Bearer token from an app
# login / the /token route; never commit the real value)
DEFINITY_API_BASE=https://definity-ai.infra.aks.prod.akamaicsi.net
DEFINITY_API_TOKEN=your_definity_jwt_here

# Your own local clone of definity-app (any branch — it's your live working
# copy, untouched by this harness). Used only as the source repo to fetch
# from when creating/refreshing a dedicated, harness-owned worktree pinned to
# AUTO_RECS_BRANCH below — never checked out or reset in place. See
# bootstrap_worktree.py; ./run.sh runs it automatically before every command.
DEFINITY_APP_REPO=~/GitCode/definity-app
# Branch this harness mirrors — override only if it's renamed.
#AUTO_RECS_BRANCH=auto-recommendations-agent

# Service mode (service/run_job.py, one subprocess per job) — leave unset for CLI use.
# AWS_SSO_AUTO_LOGIN=0       never shell out to `aws sso login` on an expired
#                            session; raise instead so the caller can drive the
#                            device-code login itself
# AWS_SSO_USE_DEVICE_CODE=1  when auto-login does run, use `--use-device-code`
#                            (headless hosts print a URL + code instead of
#                            opening a browser)
# LOCAL_SANDBOX_DIR=<dir>    parent for the per-run local sandbox folders
#                            (run_job.py points it inside the job workdir so
#                            deleting the workdir removes everything)

# Recommendation Agent web service (service/app.py) — all optional
# REC_AGENT_JOBS_DIR=data/jobs      per-job workdirs (dump, sandbox, result.json, tldr.md, log.txt)
# REC_AGENT_TTL_HOURS=4             delete a job this long after it finishes
# REC_AGENT_MAX_CONCURRENT=2        analyses running at once (one subprocess each)
# REC_AGENT_JOB_TIMEOUT_MIN=30      kill a job running longer than this
