# PostgreSQL read replica for notebook data fetches.
# Copy to .env locally (not committed) or export in your shell.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/app

# Path to definity-app backend (for tuning framework imports in notebooks).
# Absolute path recommended. If omitted, auto-detects ../../definity-app/backend
# when cost-optimizer lives beside definity-app under the same GitCode parent.
# DEFINITY_BACKEND_ROOT=/path/to/definity-app/backend
